# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=https://your-domain.com           # Public URL of this backend (no trailing slash)
FRONTEND_URL=https://your-domain.com       # Where index.html is served from

# ─── SQLite ───────────────────────────────────────────────────────────────────
DB_PATH=./data/designs.db                  # Path to SQLite database file

# ─── Download tokens ──────────────────────────────────────────────────────────
DOWNLOAD_TOKEN_EXPIRES_HOURS=72            # How long download links stay valid (default 72h)

# ─── WooCommerce ──────────────────────────────────────────────────────────────
# Leave blank to skip WooCommerce and use the placeholder checkout flow
WC_URL=https://your-store.com             # WordPress/WooCommerce site URL (no trailing slash)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxx   # WooCommerce → Settings → Advanced → REST API
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxx
WC_API_VERSION=v3                          # WooCommerce REST API version (default: v3)
# Catalogue the API will attach to a design. Comma-separated. Request productIds
# must be a subset of this list. Creature Cycles drafts (leave them draft):
#   8634 BB yoke, 8635 SS yoke, 8636 dropouts, 8637 whole rear end (optional).
WC_PRODUCT_IDS=8634,8635,8636,8637
# Single-product default used when POST /api/designs omits productIds.
# Keep this set until the client sends productIds. Optional if WC_PRODUCT_IDS
# contains exactly one id.
WC_PRODUCT_ID=8634
# Price override only when POST /api/designs omits productIds and the order
# uses WC_PRODUCT_ID. An explicit productIds array, even one id, uses each
# product's own WooCommerce price. Leave blank to always use catalogue prices.
WC_PRODUCT_PRICE=
# GET /api/prices. Timeout is milliseconds before a hung Woo read is an
# error (default 8000). Backoff is how long to wait after a failure before
# calling Woo again (default 45000, clamped to 30000–60000).
# WC_PRICE_TIMEOUT_MS=8000
# WC_PRICE_BACKOFF_MS=45000
WC_WEBHOOK_SECRET=your-webhook-secret     # WooCommerce → Settings → Advanced → Webhooks → Secret
# Webhook URL to enter in WordPress (topic: Order updated):
#   {BASE_URL}/api/webhooks/woocommerce/order-updated

# ─── Email (Resend HTTPS API) ─────────────────────────────────────────────────
# POST https://api.resend.com/emails. No SMTP — Railway blocks it.
# SMTP_HOST, SMTP_PORT, SMTP_USER, and SMTP_SECURE are not read.
# SMTP_PASS is the Resend API key (Bearer token). Leave it empty until the
# key exists. The save still succeeds and the email is skipped.
# RESEND_API_KEY is an optional alias used only when SMTP_PASS is empty.
# Domain verification in Resend is ops.
SMTP_PASS=                                 # Resend API key. Secret. Unset = no mail.
# RESEND_API_KEY=
EMAIL_FROM="Creature Cycles <info@creaturecycles.co.uk>"
EMAIL_REPLY_TO=info@creaturecycles.co.uk

# Optional. Edit links in the save email use this page. Default is the live Frame Designer.
# FRAME_DESIGNER_URL=https://creaturecycles.co.uk/apps/frame-designer.html

# Unpaid resume links. Default 90 days, and only while status is pending or
# checkout_created. A paid design rejects the token immediately.
RESUME_TOKEN_TTL_DAYS=90
# In-process cleanup of scrapped pending orders (new save after an edit leaves
# the old unpaid order behind). Unset skips the timer. 24 runs it daily.
# POST /api/admin/cleanup-unpaid is the same job, behind ADMIN_PASSWORD.
# The shop can also cancel those orders from wordpress-plugins/mu-plugins/
# creature-unpaid-design-orders.php (WP-Cron, Layout installs it).
# UNPAID_CLEANUP_INTERVAL_HOURS=24

# Data retention. A design is paid (seven-year clock) when paid_at, an
# accept/review/delivery column, a paid-family status, or Woo date_paid_gmt
# is set. The clock is that timestamp, not created_at. An unpaid row is
# anonymised only when the resume link has expired and its Woo order is
# exactly cancelled or trash, or it never had a wc_order_id. A still-valid
# resume link is kept even if that order is cancelled. Past
# RETENTION_UNRESOLVED_DAYS a row with no paid signal is anonymised
# whatever the Woo status (pending, on-hold, failed, an invalid order id,
# or an orphan). The value is at least 365 and at least RETENTION_UNPAID_DAYS.
# A paid status with no timestamp is kept for RETENTION_PAID_DAYS from
# created_at. Each run anonymises at most
# RETENTION_PURGE_MAX eligible rows and leaves the rest. Cancelled orders
# are expected, so a cancelled backlog drains across runs. The run aborts
# on a failed system_status check, Woo auth failure, more than three lookup
# errors in a row, or more than 20% of lookups failing. Invalid order ids
# abort on the same shape of threshold (a wrong WC_URL). A one-year wipe of
# a pending, on-hold, or failed order cancels it first and wipes only after
# the order reads back as cancelled. A failed cancel skips that row.
# Dry run cancels nothing. One bad order is skipped. Values below 30
# (unpaid), 365 (unresolved), or 2557 (paid) are raised. Non-numeric values
# are rejected and the default is used. The interval is 0 (off) or 1–168h.
# The purge writes only when RETENTION_PURGE_DRY_RUN is exactly 0. Anything
# else, including unset, is a dry run. First deploy: leave this at 1, read
# the [retention] lines, then set it to 0.
RETENTION_UNPAID_DAYS=90
RETENTION_UNRESOLVED_DAYS=365
RETENTION_PAID_DAYS=2557
RETENTION_PURGE_INTERVAL_HOURS=24
RETENTION_PURGE_DRY_RUN=1
RETENTION_PURGE_MAX=20
# Abort when invalid order ids exceed this many in a row, or this fraction
# of the Woo lookups in the run (at least two). Defaults match the breaker.
RETENTION_INVALID_ID_STREAK=3
RETENTION_INVALID_ID_FRACTION=0.2

# ─── Admin panel ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-to-a-strong-password  # Protects /admin and /api/admin/*

# ─── Design-file delivery lead time ───────────────────────────────────────────
# One phrase for the save-design email and the payment confirmation email.
# Must match the WordPress filter creature_fd_lead_time (default below).
# The tools-api cannot read that constant.
# FD_LEAD_TIME=5 working days
# Legacy day count, read only when FD_LEAD_TIME is unset. "7" is spoken as
# "7 working days". Delete REVIEW_LEAD_TIME_DAYS on Railway if it is still 7,
# or set it to 5. When both are set, FD_LEAD_TIME wins.
# REVIEW_LEAD_TIME_DAYS=5
